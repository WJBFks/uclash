{
  "name": "uclash",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "UClash 通用代理管理 Web UI",
  "bin": {
    "uclash": "bin/uclash.js"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"CW_DEV=1 node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "CW_DEV=1 node server/index.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "sass": "^1.103.1",
    "typescript": "~5.9",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
